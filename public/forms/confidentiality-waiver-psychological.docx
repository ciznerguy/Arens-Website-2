<script id="elementor-pro-frontend-js" src="https://arens.tik-tak.school/wp-content/plugins/elementor-pro/assets/js/frontend.min.js?ver=4.3.1"></script>
<script id="pro-elements-handlers-js" src="https://arens.tik-tak.school/wp-content/plugins/elementor-pro/assets/js/elements-handlers.min.js?ver=4.3.1"></script>
		<div id="il-privacy-banner" class="il-privacy-banner" style="display: none;" role="dialog" aria-labelledby="il-privacy-banner-title" aria-describedby="il-privacy-banner-text">
			<!-- Banner content will be injected by JS -->
		</div>

		<div id="il-privacy-modal" class="il-privacy-modal" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="il-privacy-modal-title">
			<!-- Modal content will be injected by JS -->
		</div>

				<div class="il-privacy-footer-link il-privacy-footer-link--auto il-privacy-footer-link--text">
			<a href="#" id="il-privacy-change-preferences" aria-label="שנו העדפות פרטיות" title="שנו העדפות פרטיות">
									שנו העדפות פרטיות							</a>
		</div>
				<script id="il-privacy-forms-elementor-inline">
		(function() {
			if (typeof jQuery === 'undefined') {
				return;
			}

			var ilPrivacyConsentLabel = "\u05d0\u05e0\u05d9 \u05de\u05e1\u05db\u05d9\u05dd\/\u05d4 \u05dc\u05e7\u05d1\u05dc \u05ea\u05db\u05e0\u05d9\u05dd \u05e9\u05d9\u05d5\u05d5\u05e7\u05d9\u05d9\u05dd \u05d5\u05e2\u05d3\u05db\u05d5\u05e0\u05d9\u05dd \u05d1\u05d0\u05d9\u05de\u05d9\u05d9\u05dc";
			var ilPrivacyConsentRequired = false;
			var retriesDone = false;

			function pageHasElementor() {
				return typeof elementorFrontend !== 'undefined' || jQuery('.elementor').length > 0 || jQuery('.elementor-form').length > 0;
			}

			function addConsentToElementorForms() {
				jQuery('.elementor-form').each(function() {
					var $form = jQuery(this);

					if ($form.find('.il-marketing-consent-wrapper').length > 0) {
						return;
					}

					var $submitWrapper = $form.find('.elementor-field-type-submit, .e-form__buttons').first();

					if ($submitWrapper.length === 0) {
						var $submitButton = $form.find('button[type="submit"], input[type="submit"]').first();
						if ($submitButton.length) {
							$submitWrapper = $submitButton.closest('.elementor-field-type-submit, .elementor-field-group, .e-form__buttons');
							if ($submitWrapper.length === 0) {
								$submitWrapper = $submitButton.parent();
							}
						}
					}

					var consentHtml = '<div class="elementor-field-type-checkbox elementor-field-group elementor-column elementor-col-100 il-marketing-consent-wrapper" style="margin-bottom: 20px;">' +
						'<label class="elementor-field-label" style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer; font-size: 15px; line-height: 1.5;">' +
						'<input type="checkbox" name="form_fields[il_marketing_consent]" value="1" ' + (ilPrivacyConsentRequired ? 'required ' : '') + 'style="margin-top: 3px; min-width: 18px; height: 18px; flex-shrink: 0;" />' +
						'<span style="flex: 1;">' + ilPrivacyConsentLabel + '</span>' +
						'</label>' +
						'</div>';

					if ($submitWrapper.length > 0) {
						$submitWrapper.before(consentHtml);
					} else {
						$form.append(consentHtml);
					}
				});
			}

			function runWithLimitedRetries() {
				addConsentToElementorForms();

				if (retriesDone || !pageHasElementor()) {
					return;
				}

				retriesDone = true;
				setTimeout(addConsentToElementorForms, 500);
				setTimeout(addConsentToElementorForms, 1000);
				setTimeout(addConsentToElementorForms, 2000);
			}

			jQuery(document).ready(runWithLimitedRetries);

			jQuery(window).on('load', function() {
				if (pageHasElementor()) {
					setTimeout(addConsentToElementorForms, 100);
				}
			});

			jQuery(document).on('elementor/popup/show', function() {
				setTimeout(addConsentToElementorForms, 300);
			});
		})();
		</script>
</body>
</html>
