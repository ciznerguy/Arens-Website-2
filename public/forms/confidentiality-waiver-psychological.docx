.ar-grades{background:#070b14;font-family:'Heebo',sans-serif;padding:90px 0}
.ar-grades *{margin:0;padding:0;box-sizing:border-box}
.ar-gwrap{max-width:1200px;margin:0 auto;padding:0 24px}
.ar-ghead{text-align:center;margin-bottom:52px}
.ar-gkick{font-size:13px;font-weight:700;letter-spacing:3px;color:#22d3ee}
.ar-gh2{font-size:clamp(26px,4vw,40px);font-weight:900;margin-top:10px;color:#fff}
.ar-gbar{width:70px;height:3px;margin:18px auto 0;border-radius:3px;background:linear-gradient(90deg,#22d3ee,#818cf8)}
.ar-ggrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:18px}
.ar-gcard{position:relative;text-align:center;padding:38px 18px 30px;border-radius:20px;overflow:hidden;text-decoration:none;
  background:linear-gradient(160deg,#101a30,#0d1424);border:1px solid rgba(148,163,184,.14);transition:.3s}
.ar-gcard::before{content:'';position:absolute;inset:0;opacity:0;transition:.3s;
  background:radial-gradient(circle at 50% 0%,rgba(34,211,238,.16),transparent 70%)}
.ar-gcard:hover{transform:translateY(-6px);border-color:rgba(34,211,238,.5);box-shadow:0 18px 45px rgba(0,0,0,.45)}
.ar-gcard:hover::before{opacity:1}
.ar-glet{position:relative;font-size:52px;font-weight:900;line-height:1;
  background:linear-gradient(180deg,#fff,#22d3ee);-webkit-background-clip:text;background-clip:text;color:transparent}
.ar-glbl{position:relative;display:inline-block;margin-top:16px;font-size:14px;font-weight:500;color:#94a3b8;transition:.3s}
.ar-gcard:hover .ar-glbl{color:#22d3ee}
.ar-glbl::after{content:'←';margin-inline-start:6px;display:inline-block;transition:.3s}
.ar-gcard:hover .ar-glbl::after{transform:translateX(-4px)}

